{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and water requirements",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["member", "admin"] },
        "weight": { "type": "number" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "activityLevel": { "type": "string", "enum": ["low", "moderate", "high"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin authorization registry document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "grantedAt": { "type": "string" },
        "grantedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["uid", "email", "grantedAt"]
    },
    "DailyLog": {
      "title": "DailyLog",
      "description": "Daily water intake records and total amount",
      "type": "object",
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "totalAmount": { "type": "number" },
        "target": { "type": "number" },
        "records": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["date", "totalAmount", "target"]
    },
    "ReminderSettings": {
      "title": "ReminderSettings",
      "description": "User notification and reminder configuration",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "intervalMinutes": { "type": "number" },
        "nextReminderTimestamp": { "type": "number" },
        "fcmToken": { "type": "string", "maxLength": 512 },
        "webPushEnabled": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["enabled", "intervalMinutes"]
    },
    "NotificationTemplate": {
      "title": "NotificationTemplate",
      "description": "Trendy reminder notification message template managed by admins",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "body": { "type": "string", "maxLength": 300 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "title", "body", "active"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Admin identity and permission registry"
    },
    "/users/{userId}/dailyLogs/{date}": {
      "schema": "DailyLog",
      "description": "User daily water intake logs"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "ReminderSettings",
      "description": "User reminder settings"
    },
    "/notificationTemplates/{templateId}": {
      "schema": "NotificationTemplate",
      "description": "Notification reminder copy templates"
    }
  }
}

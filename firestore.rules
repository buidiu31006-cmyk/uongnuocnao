rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Role-based Access Control via trusted /admins collection lookup
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Authorized Bootstrap Admin check (for first initial setup)
    function isBootstrapAdmin(uid) {
      return isSignedIn() && request.auth.uid == uid && request.auth.token.email == 'buidiu31006@gmail.com';
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || isBootstrapAdmin(request.auth.uid);
      allow list: if isAdmin() || isBootstrapAdmin(request.auth.uid);

      // When creating account, role MUST default to 'member' unless it's the verified bootstrap admin
      allow create: if isOwner(userId) 
        && isValidId(userId)
        && request.resource.data.uid == userId
        && (request.resource.data.role == 'member' || isBootstrapAdmin(userId));

      // Member can update their own personal info (weight, gender, activityLevel) but CANNOT change role
      // Admin or verified bootstrap admin can update fields including role
      allow update: if (
        isOwner(userId) 
        && request.resource.data.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weight', 'gender', 'activityLevel', 'displayName', 'updatedAt'])
      ) || (
        (isAdmin() || isBootstrapAdmin(request.auth.uid)) 
        && isValidId(userId)
      );

      allow delete: if isAdmin() || isBootstrapAdmin(request.auth.uid);

      // Subcollection: Daily Logs
      match /dailyLogs/{date} {
        allow read: if isOwner(userId) || isAdmin() || isBootstrapAdmin(request.auth.uid);
        allow write: if isOwner(userId) && isValidId(date);
      }

      // Subcollection: Settings (reminders, etc.)
      match /settings/{settingId} {
        allow read: if isOwner(userId) || isAdmin() || isBootstrapAdmin(request.auth.uid);
        allow write: if isOwner(userId) && isValidId(settingId);
      }
    }

    // Admins Registry Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      // Only authorized existing admins can add/remove admins, OR the designated app owner bootstrap
      allow write: if (isAdmin() && isValidId(adminId)) || (isBootstrapAdmin(adminId) && isValidId(adminId));
    }

    // Notification Templates (Admin-managed trendy reminder messages)
    match /notificationTemplates/{templateId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isBootstrapAdmin(request.auth.uid)) && isValidId(templateId);
    }
  }
}
